DB_HOST=db
DB_NAME=<db_name, change this to your actual database name> # configure this
DB_USER=<db_user, change this to your actual username> # configure this
DB_PASSWORD=<db_password, change this to your actual password> # configure this
SECRET_KEY=<secret_key, generate using `openssl rand -hex 32`> # configure this

TEST_HOST=test
TEST_USER=<test_db_user, change this to your actual test username> # configure this
TEST_PASSWORD=<test_db_password, change this to your actual test password> # configure this
TEST_NAME=<test_db_name, change this to your actual test database name> # configure this

REDIS_HOST=redis
REDIS_PORT=6379

TEST_REDIS_HOST=test_redis
TEST_REDIS_PORT=6379

BACKEND_PORT=8000

FRONTEND_PORT=5173

BACKEND_LOG_DIR=logs
MEMORY_AGENT_LOG_DIR=logs
MEMORY_AGENT_LOG_FILENAME=memory-agent-local.jsonl

COMPOSE_PROJECT_NAME=noveltl_dev

DEEPSEEK_API_KEY=
QWEN_API_KEY=
QWEN_API_URL=
HF_TOKEN=


# Garage cluster/admin RPC only; S3 clients use separate access keys.
# Generate with: openssl rand -hex 32
GARAGE_RPC_SECRET=

# S3-compatible file storage. Garage access keys can be generated with:
# printf 'GK%s\n' "$(openssl rand -hex 16)"; openssl rand -hex 32
FILE_STORE_NAME=default
S3_ENDPOINT_URL=http://garage:3900
S3_BUCKET=noveltl
S3_REGION=garage
S3_ADDRESSING_STYLE=path
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
