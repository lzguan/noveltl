{
	"name": "frontend",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"generate:api": "node scripts/generate-api.mjs",
		"dev": "vite",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
