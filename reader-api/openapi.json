                "type": "null"
              }
            ],
            "title": "Externalversion"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          },
          "clientHash": {
            "type": "string",
            "title": "Clienthash"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "title": "Createdat"
          }
        },
        "type": "object",
        "required": [
          "feedbackId",
          "novelId",
          "novelTitle",
          "chapterId",
          "chapterNum",
          "contentHash",
          "externalVersion",
          "kind",
          "payload",
          "clientHash",
          "createdAt"
        ],
        "title": "AdminFeedbackItem"
      },
      "AdminFeedbackListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AdminFeedbackItem"
            },
            "type": "array",
            "title": "Items"
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nextcursor"
          }
        },
        "type": "object",
        "required": [
          "items",
          "nextCursor"
        ],
        "title": "AdminFeedbackListResponse"
      },
