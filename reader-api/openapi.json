    "/novels/{novelId}/chapters/{chapterNum}/feedback": {
      "post": {
        "tags": [
          "public"
        ],
        "summary": "Create Chapter Feedback",
        "operationId": "create_chapter_feedback",
        "parameters": [
          {
            "name": "novelId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Novelid"
            }
          },
          {
            "name": "chapterNum",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "title": "Chapternum"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/FeedbackReactionCreateRequest"
                  },
                  {
                    "$ref": "#/components/schemas/FeedbackIssueCreateRequest"
                  },
                  {
                    "$ref": "#/components/schemas/FeedbackCommentCreateRequest"
                  }
                ],
                "discriminator": {
                  "propertyName": "kind",
                  "mapping": {
                    "reaction": "#/components/schemas/FeedbackReactionCreateRequest",
                    "issue": "#/components/schemas/FeedbackIssueCreateRequest",
                    "comment": "#/components/schemas/FeedbackCommentCreateRequest"
                  }
                },
                "title": "Payload"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
